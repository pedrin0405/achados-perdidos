# Nome do banco criado dentro do contêiner PostgreSQL (usado também como DB_NAME
# pela aplicação web).
POSTGRES_DB=achados

# Usuário do PostgreSQL criado na primeira inicialização (usado também como DB_USER).
POSTGRES_USER=achados

# Senha do usuário acima. Este é um valor de exemplo: troque-o localmente.
POSTGRES_PASSWORD=troque-esta-senha-ficticia-de-desenvolvimento